@page "/about"
@inherits About_razor

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&family=Space+Grotesk:wght@400;600;700&display=swap');

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Noto Sans SC', sans-serif;
        background: #f8f5f0;
        min-height: 100vh;
        overflow-x: hidden;
    }

    /* ── 背景浮球 ── */
    .about-background {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .about-ball {
        position: absolute;
        border-radius: 50%;
        filter: blur(72px);
        opacity: 0.35;
        animation: floatBall 8s ease-in-out infinite alternate;
    }

    @@keyframes floatBall {
        0%   { transform: translate(0, 0) scale(1); }
        100% { transform: translate(18px, -22px) scale(1.06); }
    }

    /* ── 页面布局 ── */
    .about-wrapper {
        position: relative;
        z-index: 1;
        max-width: 900px;
        margin: 0 auto;
        padding: 48px 20px 80px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* ── 通用卡片 ── */
    .a-card {
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(18px);
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.85);
        box-shadow: 0 4px 32px rgba(0,0,0,0.07);
        padding: 28px 32px;
        transition: transform 0.25s, box-shadow 0.25s;
    }

    .a-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.11);
    }

    /* ── Hero 头部卡片 ── */
    .hero-card {
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
    }

    .hero-avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #ffb347;
        box-shadow: 0 0 0 6px rgba(255,179,71,0.2);
        flex-shrink: 0;
    }

    .hero-name {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: -0.5px;
    }

    .hero-tagline {
        font-size: 14px;
        color: #888;
        margin-top: 4px;
    }

    .hero-badge {
        display: inline-block;
        margin-top: 10px;
        padding: 4px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
        background: linear-gradient(90deg, #ffb347, #a8e063);
        color: #fff;
        letter-spacing: 0.5px;
    }

    /* ── 章节标题 ── */
    .section-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, #ffb347 0%, transparent 100%);
        opacity: 0.5;
    }

    /* ── 自我介绍文字 ── */
    .bio-text {
        font-size: 15px;
        line-height: 1.9;
        color: #444;
    }

    .bio-text strong {
        color: #e07b00;
        font-weight: 600;
    }

    /* ── 时间线 ── */
    .timeline {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .tl-item {
        display: flex;
        gap: 16px;
        position: relative;
    }

    .tl-item:not(:last-child) .tl-line {
        position: absolute;
        left: 11px;
        top: 24px;
        bottom: -16px;
        width: 2px;
        background: linear-gradient(180deg, #ffb347 0%, #a8e063 100%);
        opacity: 0.4;
    }

    .tl-dot {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ffb347, #a8e063);
        flex-shrink: 0;
        margin-top: 2px;
        box-shadow: 0 0 0 4px rgba(255,179,71,0.15);
    }

    .tl-content {
        padding-bottom: 24px;
        flex: 1;
    }

    .tl-year {
        font-size: 12px;
        color: #aaa;
        font-weight: 500;
        margin-bottom: 2px;
    }

    .tl-title {
        font-size: 15px;
        font-weight: 600;
        color: #222;
    }

    .tl-desc {
        font-size: 13px;
        color: #666;
        margin-top: 2px;
        line-height: 1.6;
    }

    /* ── 技能标签 ── */
    .tag-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 4px;
    }

    .tag {
        padding: 5px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 500;
        cursor: default;
        transition: transform 0.15s;
        user-select: none;
    }

    .tag:hover {
        transform: scale(1.06);
    }

    .tag-orange  { background: #fff3e0; color: #e07b00; border: 1px solid #ffd699; }
    .tag-green   { background: #f0fce8; color: #52a018; border: 1px solid #b8e88a; }
    .tag-blue    { background: #e8f4ff; color: #1a7fce; border: 1px solid #9ecfee; }
    .tag-pink    { background: #fff0f5; color: #d94f7a; border: 1px solid #f9aec9; }
    .tag-purple  { background: #f3eeff; color: #7b4fce; border: 1px solid #c9aaf9; }

    /* ── 兴趣爱好网格 ── */
    .hobby-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 14px;
        margin-top: 4px;
    }

    .hobby-item {
        background: rgba(255,255,255,0.6);
        border: 1px solid rgba(255,179,71,0.25);
        border-radius: 14px;
        padding: 16px 10px;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hobby-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(255,179,71,0.18);
    }

    .hobby-icon {
        font-size: 28px;
        margin-bottom: 6px;
    }

    .hobby-label {
        font-size: 12px;
        color: #666;
        font-weight: 500;
    }

    /* ── 目标/座右铭卡片 ── */
    .motto-card {
        background: linear-gradient(135deg, rgba(255,179,71,0.18) 0%, rgba(168,224,99,0.18) 100%);
        border: 1px solid rgba(255,179,71,0.35);
        border-radius: 20px;
        padding: 28px 32px;
        text-align: center;
    }

    .motto-quote {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #c96b00;
        line-height: 1.6;
        position: relative;
    }

    .motto-quote::before {
        content: '"';
        font-size: 60px;
        color: #ffb347;
        opacity: 0.3;
        position: absolute;
        top: -18px;
        left: -10px;
        font-family: Georgia, serif;
        line-height: 1;
    }

    .motto-sub {
        font-size: 13px;
        color: #999;
        margin-top: 8px;
    }

    /* ── 响应式 ── */
    @@media (max-width: 600px) {
        .hero-card { flex-direction: column; text-align: center; }
        .a-card { padding: 22px 18px; }
    }
</style>

<!-- 背景浮球（换色系） -->
<div class="about-background">
    <div class="about-ball" style="width:220px;height:220px;background:#ffb347;top:8%;left:10%;animation-delay:0s;"></div>
    <div class="about-ball" style="width:280px;height:280px;background:#a8e063;top:40%;left:65%;animation-delay:2s;"></div>
    <div class="about-ball" style="width:200px;height:200px;background:#4fc3f7;top:72%;left:20%;animation-delay:4s;"></div>
    <div class="about-ball" style="width:240px;height:240px;background:#ffd54f;top:85%;left:75%;animation-delay:1s;"></div>
</div>

