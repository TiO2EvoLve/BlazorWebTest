@page "/game"
@using Web.Entitys
@inherits Game_razor
@inject HttpClient Http

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&family=Barlow+Condensed:wght@400;600;700&display=swap');


    .game-root { background: #0e1420; }

    /* ── 背景浮球（蓝色 Steam 风） ── */
    .game-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .game-ball {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.18;
        animation: gbFloat 10s ease-in-out infinite alternate;
    }

    @@keyframes gbFloat {
        0%   { transform: translate(0, 0) scale(1); }
        100% { transform: translate(20px, -25px) scale(1.07); }
    }

    /* ── 页面根容器 ── */
    .game-root {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        color: #c7d5e0;
        font-family: 'Noto Sans SC', sans-serif;
    }

    .game-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px 80px;
    }

    /* ── 页面标题 ── */
    .page-heading {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 32px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 1px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-heading span {
        color: #66c0f4;
    }

    /* ── 通用卡片 ── */
    .s-card {
        background: rgba(26, 37, 53, 0.75);
        backdrop-filter: blur(18px);
        border: 1px solid #2a3f5a;
        border-radius: 16px;
        box-shadow: 0 4px 30px rgba(0,0,0,0.4);
        transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
        overflow: hidden;
    }

    .s-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 0 1px #66c0f4;
        border-color: rgba(102,192,244,0.45);
    }

    /* ── 加载态 ── */
    .loading-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: #0e1420;
        color: #c7d5e0;
        gap: 18px;
    }

    .steam-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #2a3f5a;
        border-top-color: #66c0f4;
        border-radius: 50%;
        animation: spin 0.9s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ── Profile 主卡 ── */
    .profile-card {
        padding: 32px;
        margin-bottom: 32px;
        background: linear-gradient(135deg,
        rgba(26,37,53,0.92) 0%,
        rgba(20,30,48,0.92) 50%,
        rgba(14,20,32,0.92) 100%);
        border: 1px solid #2a3f5a;
        position: relative;
    }

    /* 顶部光晕线 */
    .profile-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #66c0f4, transparent);
        opacity: 0.7;
    }

    .profile-inner {
        display: flex;
        gap: 36px;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    /* 头像区 */
    .avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .avatar-frame {
        width: 180px;
        height: 180px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #66c0f4;
        box-shadow:
            0 0 20px rgba(102,192,244,0.3),
            0 8px 32px rgba(0,0,0,0.6);
    }

    .avatar-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .avatar-name-bar {
        margin-top: 10px;
        text-align: center;
    }

    .avatar-name {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.5px;
    }

    .status-pill {
        display: inline-block;
        margin-top: 6px;
        padding: 3px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        background: rgba(102,192,244,0.15);
        color: #66c0f4;
        border: 1px solid rgba(102,192,244,0.35);
        letter-spacing: 0.5px;
    }

    /* 信息区 */
    .info-cols {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .info-block {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        padding: 18px 20px;
    }

    .info-block-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #66c0f4;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        font-size: 13px;
        gap: 8px;
    }

    .info-row:last-child { border-bottom: none; }

    .info-label { color: #7a9ab5; white-space: nowrap; }
    .info-value { color: #c7d5e0; font-weight: 500; text-align: right; word-break: break-all; }

    /* 按钮 */
    .btn-group {
        margin-top: 20px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background: linear-gradient(135deg, #4fa3d4, #66c0f4);
        color: #0e1420;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 0.5px;
        padding: 9px 22px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: filter 0.2s, transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 14px rgba(102,192,244,0.3);
    }

    .btn-primary:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102,192,244,0.4);
    }

    .btn-secondary {
        background: rgba(102,192,244,0.1);
        color: #66c0f4;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 0.5px;
        padding: 9px 22px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid rgba(102,192,244,0.35);
        transition: background 0.2s, transform 0.2s;
    }

    .btn-secondary:hover {
        background: rgba(102,192,244,0.2);
        transform: translateY(-2px);
    }

    /* ── 章节头 ── */
    .section-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .section-head-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.5px;
    }

    .section-head-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, #2a3f5a 0%, transparent 100%);
    }

    /* ── 游戏卡片网格 ── */
    .games-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 18px;
    }

    .game-card {
        background: rgba(26,37,53,0.8);
        backdrop-filter: blur(12px);
        border: 1px solid #2a3f5a;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
        cursor: pointer;
        position: relative;
    }

    .game-card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(102,192,244,0.08) 0%, transparent 60%);
        opacity: 0;
        transition: opacity 0.25s;
        pointer-events: none;
    }

    .game-card:hover {
        transform: translateY(-5px) scale(1.01);
        box-shadow: 0 16px 40px rgba(0,0,0,0.55), 0 0 0 1px rgba(102,192,244,0.4);
        border-color: rgba(102,192,244,0.4);
    }

    .game-card:hover::after { opacity: 1; }

    .game-cover {
        width: 100%;
        height: 130px;
        object-fit: cover;
        display: block;
        /* 顶部渐变遮罩 */
        mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent 100%);
    }

    .game-info {
        padding: 14px 16px 16px;
    }

    .game-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.3px;
        margin-bottom: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .game-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #7a9ab5;
        margin-bottom: 12px;
    }

    .game-meta-recent {
        color: #57cbde;
        font-weight: 600;
    }

    /* 进度条显示总时长 */
    .playtime-bar-wrap {
        margin-bottom: 12px;
    }

    .playtime-bar-label {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #7a9ab5;
        margin-bottom: 4px;
    }

    .playtime-bar-label span:last-child {
        color: #66c0f4;
        font-weight: 600;
    }

    .playtime-bar-track {
        height: 3px;
        background: rgba(255,255,255,0.08);
        border-radius: 999px;
        overflow: hidden;
    }

    .playtime-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #4fa3d4, #66c0f4);
        border-radius: 999px;
        min-width: 6px;
    }

    .game-link {
        display: block;
        text-align: center;
        background: rgba(102,192,244,0.1);
        border: 1px solid rgba(102,192,244,0.25);
        color: #66c0f4;
        font-size: 12px;
        font-weight: 600;
        padding: 6px;
        border-radius: 7px;
        text-decoration: none;
        letter-spacing: 0.4px;
        transition: background 0.2s;
    }

    .game-link:hover {
        background: rgba(102,192,244,0.22);
    }

    /* ── 响应式 ── */
    @@media (max-width: 640px) {
        .profile-inner { flex-direction: column; }
        .avatar-frame { width: 140px; height: 140px; }
        .profile-card { padding: 20px; }
        .game-inner { padding: 20px 14px 60px; }
    }
</style>

<!-- 背景浮球 -->
<div class="game-bg">
    <div class="game-ball" style="width:300px;height:300px;background:#1a6fa8;top:5%;left:5%;animation-delay:0s;"></div>
    <div class="game-ball" style="width:380px;height:380px;background:#0d3d5e;top:45%;left:60%;animation-delay:3s;"></div>
    <div class="game-ball" style="width:260px;height:260px;background:#66c0f4;top:75%;left:15%;animation-delay:5s;"></div>
    <div class="game-ball" style="width:220px;height:220px;background:#1e4d72;top:20%;left:80%;animation-delay:1.5s;"></div>
</div>

<div class="game-root">

    @if (player == null)
    {
    <div class="loading-wrap">
        <div class="steam-spinner"></div>
        <p style="font-size:15px;color:#7a9ab5;">正在加载 Steam 数据…</p>
    </div>
    }
    else
    {
    <div class="game-inner">

        <!-- 页面标题 -->
        <div class="page-heading">
            🎮 <span>Steam</span> 个人主页
        </div>

        <!-- ── Profile 主卡 ── -->
        <div class="s-card profile-card">
            <div class="profile-inner">

                <!-- 头像 -->
                <div class="avatar-wrap">
                    <div class="avatar-frame">
                        <img src="@player.AvatarFull" alt="头像" />
                    </div>
                    <div class="avatar-name-bar">
                        <div class="avatar-name">@player.PersonaName</div>
                        <span class="status-pill">@state[player.Personastate]</span>
                    </div>
                </div>

                <!-- 信息列 -->
                <div style="flex:1">
                    <div class="info-cols">
                        <!-- 基本信息 -->
                        <div class="info-block">
                            <div class="info-block-title">👤 基本信息</div>
                            <div class="info-row">
                                <span class="info-label">Steam ID</span>
                                <span class="info-value" style="font-size:11px;">@player.SteamId</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">注册时间</span>
                                <span class="info-value">@GetTime(player.Timecreated)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">最后登录</span>
                                <span class="info-value">@GetTime(player.Lastlogoff)</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">所在地区</span>
                                <span class="info-value">@player.Loccountrycode</span>
                            </div>
                        </div>

                        <!-- 账户状态 -->
                        <div class="info-block">
                            <div class="info-block-title">⚙️ 账户状态</div>
                            <div class="info-row">
                                <span class="info-label">个人资料</span>
                                <span class="info-value">公开</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">评论权限</span>
                                <span class="info-value">允许</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">主群组</span>
                                <span class="info-value" style="font-size:11px;">@player.primaryclanid</span>
                            </div>
                            <div class="info-row">
                                <span class="info-label">状态标志</span>
                                <span class="info-value" style="color:#57cbde;">正常</span>
                            </div>
                        </div>
                    </div>

                    <!-- 操作按钮 -->
                    <div class="btn-group">
                        <a href="@player.Profileurl" target="_blank" class="btn-primary">
                            🔗 查看完整资料
                        </a>
                        <a href="@player.Profileurl" target="_blank" class="btn-secondary">
                            ➕ 添加好友
                        </a>
                    </div>
                </div>

            </div>
        </div>

        <!-- ── 最近游玩 ── -->
        <div class="section-head">
            <div class="section-head-title">🕹 最近玩过的游戏</div>
            <div class="section-head-line"></div>
        </div>

        <div class="games-grid">
            @{
            // 用于进度条：以最大总时长为基准
            var maxMinutes = games.Count > 0 ? games.Max(g => g.playtime_forever) : 1;
            if (maxMinutes == 0) maxMinutes = 1;
            }
            @foreach (var game in games)
            {
            var barWidth = (int)Math.Clamp((double)game.playtime_forever / maxMinutes * 100, 4, 100);
            <div class="game-card">
                <img src="@game.HeaderImage" alt="@game.name" class="game-cover" />
                <div class="game-info">
                    <div class="game-title" title="@game.name">@game.name</div>
                    <div class="game-meta">
                        <span class="game-meta-recent">▶ 近期 @(game.playtime_2weeks / 60) 小时</span>
                    </div>
                    <div class="playtime-bar-wrap">
                        <div class="playtime-bar-label">
                            <span>总游戏时长</span>
                            <span>@(game.playtime_forever / 60) 小时</span>
                        </div>
                        <div class="playtime-bar-track">
                            <div class="playtime-bar-fill" style="width:@(barWidth)%"></div>
                        </div>
                    </div>
                    <a href="https://store.steampowered.com/agecheck/app/@game.appid"
                       target="_blank" class="game-link">
                        在 Steam 中查看 →
                    </a>
                </div>
            </div>
            }
        </div>

    </div>
    }

</div>
